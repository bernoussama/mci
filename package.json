{
  "name": "mci",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "@hono/node-server": "^2.1.1",
    "@vitejs/plugin-react": "latest",
    "ai": "^7.0.83",
    "hono": "^4.13.5",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
